# Build container for the RX65N firmware.
#
# Separate from container/Containerfile: that one hosts the QEMU VM that runs
# rfp-cli, this one only needs a C toolchain. Nothing is installed on the host.
#
#   podman build -t rx65n-fw -f Containerfile .
#   podman run --rm -v "$PWD":/work:Z -w /work rx65n-fw \
#       bash -c 'bash fetch-demo.sh && make'
#
# The GNU RX toolchain itself is fetched by fetch-demo.sh rather than baked in,
# so the image stays small and the toolchain version is visible in one place.

FROM debian:13

RUN apt-get update && apt-get install -y --no-install-recommends \
        make \
        curl \
        python3 \
        ca-certificates \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

CMD ["bash"]
